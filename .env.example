# Site URL - Update this with your actual domain
NEXT_PUBLIC_SITE_URL=https://glenncaninguitars.com

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
# Shared secret for the Sanity → /api/revalidate webhook (HMAC-SHA256).
# Generate any random string, then paste the same value into Sanity's webhook
# "Secret" field at https://sanity.io/manage
SANITY_REVALIDATE_SECRET=

# Resend (contact form) — get key at https://resend.com/api-keys
# Sending domain (glenncaninguitars.com) must be verified in Resend first.
RESEND_API_KEY=
# From address — must match a domain verified in Resend
CONTACT_EMAIL_FROM="Glenn Canin Guitars <contact@glenncaninguitars.com>"
# Recipient is edited in Sanity Studio (Contact Page → Email).
# This var is only used as a fallback if the CMS field is empty.
CONTACT_EMAIL_TO=

# Google Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Other analytics or monitoring services
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX